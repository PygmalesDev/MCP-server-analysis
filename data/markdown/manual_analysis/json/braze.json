  "observations": [
    {
      "type": "Systematic difference",
      "text": "The most \"writing\" server among the cloud ones: 34 changing tools incl. launching and stopping campaigns (real mailings), with no server-side confirmation - only the recommendation not to use auto-mode.",
      "src": "available_api_functions; usage page"
    },
    {
      "type": "Systematic difference",
      "text": "Strong administrative access control (permission off by default, redirect URI approval, client allowlist, mass token revocation) combined with weak control of individual actions.",
      "src": "setup page"
    },
    {
      "type": "New design option",
      "text": "A nested vendor agent (BrazeAI Operator): the external agent delegates a task to Braze's internal AI - not covered by the task items.",
      "src": "available_api_functions (Operator)"
    },
    {
      "type": "New design option",
      "text": "Beta gating of tools: the set of capabilities depends on participation in a beta program.",
      "src": "available_api_functions"
    },
    {
      "type": "Systematic difference",
      "text": "Explicit shift of responsibility to the user and the AI client (legal disclaimer on the tools page).",
      "src": "available_api_functions; usage page"
    },
    {
      "type": "New design option",
      "text": "Exclusion of PII as a design principle - comparable to GoCardless's masking, but implemented at the level of the tool set.",
      "src": "overview page"
    }
  ]
